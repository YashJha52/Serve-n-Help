<?xml version="1.0" encoding="utf-8"?>
<!--
    Serve-N-Help palette. Mood: warm, grounded, dependable.
    A paper-toned background like a kitchen order pad, one forest-green accent
    (about 10% of any screen), and fixed semantic colours for food status.
    Dark values live in values-night/colors.xml.
-->
<resources>
    <!-- 60%: page background -->
    <color name="bg">#FAF6EF</color>
    <!-- 30%: cards, sheets, bars -->
    <color name="surface">#FFFDF8</color>
    <color name="surface_alt">#F1EBE0</color>
    <color name="line">#E3DACB</color>
    <!-- Selected option in a segmented control: lifts above the sand track -->
    <color name="segment_on">#FFFDF8</color>

    <!-- Text, tinted slightly warm to belong to the palette -->
    <color name="ink">#1E1A14</color>
    <color name="ink_muted">#655C50</color>
    <color name="ink_faint">#7C7366</color>

    <!-- 10%: the one accent -->
    <color name="accent">#2F6B4F</color>
    <color name="accent_strong">#24543E</color>
    <color name="accent_tint">#E2EEE6</color>
    <color name="on_accent">#FFFFFF</color>

    <!-- Semantic: never reused for decoration -->
    <color name="warning">#8A4500</color>
    <color name="warning_tint">#FBEAD2</color>
    <color name="danger">#A8261D</color>
    <color name="danger_tint">#F8E0DC</color>
    <color name="info">#1D5A86</color>
    <color name="info_tint">#E0EBF4</color>

    <color name="scrim">#66000000</color>
</resources>
