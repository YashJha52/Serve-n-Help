<?xml version="1.0" encoding="utf-8"?>
<!--
    Account: who you are, what you've done (past donations or deliveries), your details,
    and appearance. Sign out sits at the very end so it is never the first thing you hit.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4">

        <ImageButton
            android:id="@+id/btn_back_profile"
            style="@style/Widget.SNH.IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:text="Account"
            android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_profile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_32">

            <!-- Identity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_profile_avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.SNH.Section" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.SNH.Title" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_profile_role"
                            style="@style/Widget.SNH.Tag"
                            android:backgroundTint="@color/accent_tint"
                            android:textColor="@color/accent_strong" />

                        <TextView
                            android:id="@+id/tv_profile_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.SNH.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Impact -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_band"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/space_16">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16">

                    <TextView
                        android:id="@+id/tv_profile_stat1_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.SNH.Title" />

                    <TextView
                        android:id="@+id/tv_profile_stat1_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SNH.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16">

                    <TextView
                        android:id="@+id/tv_profile_stat2_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.SNH.Title" />

                    <TextView
                        android:id="@+id/tv_profile_stat2_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SNH.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16">

                    <TextView
                        android:id="@+id/tv_profile_stat3_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.SNH.Title" />

                    <TextView
                        android:id="@+id/tv_profile_stat3_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SNH.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- History -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_history_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Past donations"
                    android:textAppearance="@style/TextAppearance.SNH.Section" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_history_all"
                    style="@style/Widget.SNH.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:id="@+id/layout_history_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Details -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Account details" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="Tap a detail to change it. NGOs and donors see your name and phone when you work together."
                android:textAppearance="@style/TextAppearance.SNH.BodySmall" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:id="@+id/layout_detail_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Appearance -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Appearance" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_segmented"
                android:divider="@drawable/space_4"
                android:orientation="horizontal"
                android:padding="@dimen/space_4"
                android:showDividers="middle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_theme_system"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target"
                    android:paddingHorizontal="@dimen/space_8"
                    android:text="Auto"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_smartphone"
                    app:iconGravity="textStart"
                    app:iconSize="@dimen/icon_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_theme_light"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target"
                    android:paddingHorizontal="@dimen/space_8"
                    android:text="Light"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_light_mode"
                    app:iconGravity="textStart"
                    app:iconSize="@dimen/icon_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_theme_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_target"
                    android:paddingHorizontal="@dimen/space_8"
                    android:text="Dark"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_dark_mode"
                    app:iconGravity="textStart"
                    app:iconSize="@dimen/icon_small" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_theme_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.SNH.Caption" />

            <!-- Sign out -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_signout"
                style="@style/Widget.SNH.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_48"
                android:text="Sign out"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart" />

            <TextView
                android:id="@+id/tv_profile_since"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.SNH.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
