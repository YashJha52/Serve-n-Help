<?xml version="1.0" encoding="utf-8"?>
<!-- Sign in: one role choice, two fields, one primary action. Alternatives sit below. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_24">

        <!-- Brand -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_serve_n_help_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:text="Serve-N-Help"
                android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="Sign in"
            android:textAppearance="@style/TextAppearance.SNH.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="Pass on today's surplus before it goes to waste."
            android:textAppearance="@style/TextAppearance.SNH.BodySmall" />

        <!-- Role -->
        <TextView
            style="@style/Widget.SNH.FieldLabel"
            android:layout_marginTop="@dimen/space_32"
            android:text="I'm signing in as" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segmented"
            android:orientation="horizontal"
            android:padding="@dimen/space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_role_donor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target"
                android:text="Food donor"
                android:textSize="14sp"
                app:icon="@drawable/ic_storefront"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_small" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_role_ngo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:minHeight="@dimen/touch_target"
                android:text="NGO"
                android:textSize="14sp"
                app:icon="@drawable/ic_volunteer_activism"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_small" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_role_hint_icon"
                android:layout_width="@dimen/icon_small"
                android:layout_height="@dimen/icon_small"
                android:contentDescription="@null"
                android:src="@drawable/ic_restaurant"
                app:tint="@color/ink_muted" />

            <TextView
                android:id="@+id/tv_role_hint_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.SNH.Caption" />
        </LinearLayout>

        <!-- Credentials -->
        <TextView
            style="@style/Widget.SNH.FieldLabel"
            android:layout_marginTop="@dimen/space_24"
            android:text="Email" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:hint="you@restaurant.in"
                android:id="@+id/et_email"
                style="@style/Widget.SNH.EditText"
                android:autofillHints="emailAddress"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.SNH.FieldLabel"
            android:text="Password" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password"
                style="@style/Widget.SNH.EditText"
                android:autofillHints="password"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_remember_me"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:minHeight="@dimen/touch_target"
                android:text="Keep me signed in"
                android:textAppearance="@style/TextAppearance.SNH.BodySmall" />

            <TextView
                android:id="@+id/tv_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_8"
                android:text="Forgot password?"
                android:textAppearance="@style/TextAppearance.SNH.Label"
                android:textColor="@color/accent" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/sign_in_as_restaurant" />

        <!-- Alternatives -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                style="@style/Widget.SNH.Divider"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_12"
                android:text="or continue with"
                android:textAppearance="@style/TextAppearance.SNH.Caption" />

            <View
                style="@style/Widget.SNH.Divider"
                android:layout_width="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sso_google"
                style="@style/Widget.SNH.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Google"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sso_ngo"
                style="@style/Widget.SNH.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:text="@string/ngo_gov_id"
                app:icon="@drawable/ic_badge"
                app:iconGravity="textStart" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_32" />

        <TextView
            android:id="@+id/tv_register_partner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="New here? Create an account"
            android:textAppearance="@style/TextAppearance.SNH.Label"
            android:textColor="@color/accent" />
    </LinearLayout>
</ScrollView>
