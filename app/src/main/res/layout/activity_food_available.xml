<?xml version="1.0" encoding="utf-8"?>
<!-- Donation feed (NGO home / donor listings): search and filter, then the list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_food_available"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btn_back_food_available"
            style="@style/Widget.SNH.IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_feed_header_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="180dp"
                    android:textAppearance="@style/TextAppearance.SNH.Caption" />

                <TextView
                    android:id="@+id/tv_feed_header_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.SNH.Caption"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_feed_title_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food available"
                android:textAppearance="@style/TextAppearance.SNH.Title" />

            <TextView
                android:id="@+id/tv_feed_live_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_feed_notifications"
            style="@style/Widget.SNH.IconButton"
            android:contentDescription="Updates"
            android:src="@drawable/ic_notifications" />

        <ImageView
            android:id="@+id/iv_feed_profile"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_icon_button_filled"
            android:clickable="true"
            android:contentDescription="Your account"
            android:focusable="true"
            android:scaleType="center"
            android:src="@drawable/ic_person"
            app:tint="@color/ink" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Search + map -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/screen_margin">

                    <EditText
                        android:id="@+id/et_food_search"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_target"
                        android:layout_weight="1"
                        android:background="@drawable/bg_search"
                        android:drawablePadding="@dimen/space_8"
                        android:hint="Search food, area or notes"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/space_12"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/ink_muted"
                        android:textSize="16sp"
                        app:drawableStartCompat="@drawable/ic_search"
                        app:drawableTint="@color/ink_muted" />

                    <ImageButton
                        android:id="@+id/btn_filter_tune"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/bg_search"
                        android:contentDescription="Show on map"
                        android:src="@drawable/ic_location_on"
                        app:tint="@color/accent" />
                </LinearLayout>

                <!-- Category filter -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/chip_all" style="@style/Widget.SNH.Chip" android:text="All" />
                        <TextView android:id="@+id/chip_cat1" style="@style/Widget.SNH.Chip" android:text="Cooked meals" />
                        <TextView android:id="@+id/chip_cat2" style="@style/Widget.SNH.Chip" android:text="Bakery" />
                        <TextView android:id="@+id/chip_cat3" style="@style/Widget.SNH.Chip" android:text="Raw produce" />
                        <TextView android:id="@+id/chip_cat4" style="@style/Widget.SNH.Chip" android:text="Packaged food" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Impact / hint line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@drawable/bg_band"
                    android:orientation="vertical"
                    android:padding="@dimen/space_12">

                    <TextView
                        android:id="@+id/tv_feed_banner_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SNH.Label" />

                    <TextView
                        android:id="@+id/tv_feed_banner_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_available_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/screen_margin" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btn_quick_add_food"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_16"
            android:text="@string/add_food_cta"
            android:visibility="gone"
            app:icon="@drawable/ic_add" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation_feed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
