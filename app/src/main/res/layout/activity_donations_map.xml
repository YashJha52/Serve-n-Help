<?xml version="1.0" encoding="utf-8"?>
<!-- Every available donation as a pin; tap a pin's label to open it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map_donations"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/btn_back_map"
        style="@style/Widget.SNH.IconButton"
        android:layout_margin="@dimen/space_16"
        android:background="@drawable/bg_map_button"
        android:contentDescription="Back"
        android:src="@drawable/ic_arrow_back" />

    <TextView
        android:id="@+id/tv_map_count"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_card_plain"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_16"
        android:text="Loading donations…"
        android:textAppearance="@style/TextAppearance.SNH.Label" />
</FrameLayout>
