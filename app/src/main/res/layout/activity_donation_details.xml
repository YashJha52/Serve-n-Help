<?xml version="1.0" encoding="utf-8"?>
<!-- Donation details: what it is, how far along, who's handling it, where. Actions pinned below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_donation_details"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4">

        <ImageButton
            android:id="@+id/btn_back_details"
            style="@style/Widget.SNH.IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tv_details_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.SNH.Label"
            android:textColor="@color/ink_muted" />

        <ImageButton
            android:id="@+id/btn_details_share"
            style="@style/Widget.SNH.IconButton"
            android:contentDescription="Share this donation"
            android:src="@drawable/ic_share" />

        <ImageButton
            android:id="@+id/btn_details_more"
            style="@style/Widget.SNH.IconButton"
            android:contentDescription="More options"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_24">

            <!-- Headline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_details_status"
                    style="@style/Widget.SNH.Tag" />

                <TextView
                    android:id="@+id/tv_details_category"
                    style="@style/Widget.SNH.Tag"
                    android:layout_marginStart="@dimen/space_8" />

                <TextView
                    android:id="@+id/tv_details_diet"
                    style="@style/Widget.SNH.Tag"
                    android:layout_marginStart="@dimen/space_8" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_details_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.SNH.Display" />

            <TextView
                android:id="@+id/tv_details_expiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:drawablePadding="@dimen/space_8"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.SNH.Label"
                android:textColor="@color/warning"
                app:drawableStartCompat="@drawable/ic_schedule"
                app:drawableTint="@color/warning" />

            <!-- Facts band -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_band"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/space_16">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quantity"
                        android:textAppearance="@style/TextAppearance.SNH.Caption" />

                    <TextView
                        android:id="@+id/tv_details_servings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight"
                        android:textAppearance="@style/TextAppearance.SNH.Caption" />

                    <TextView
                        android:id="@+id/tv_details_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_16">

                    <TextView
                        android:id="@+id/tv_details_containers_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Made at"
                        android:textAppearance="@style/TextAppearance.SNH.Caption" />

                    <TextView
                        android:id="@+id/tv_details_containers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />
                </LinearLayout>
            </LinearLayout>

            <!-- Progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:layout_marginBottom="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Progress"
                    android:textAppearance="@style/TextAppearance.SNH.Section" />

                <TextView
                    android:id="@+id/tv_details_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SNH.Caption" />
            </LinearLayout>

            <!-- Step 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_step1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_todo"
                        android:contentDescription="Published"
                        android:padding="6dp"
                        android:src="@drawable/ic_check" />
                    <View
                        android:id="@+id/line_step1"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginVertical="@dimen/space_4"
                        android:layout_weight="1"
                        android:minHeight="16dp"
                        android:background="@color/line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_step1_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Published"
                            android:textAppearance="@style/TextAppearance.SNH.Label" />

                        <TextView
                            android:id="@+id/tv_step1_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.SNH.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_step1_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                </LinearLayout>
            </LinearLayout>
            <!-- Step 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_step2"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_todo"
                        android:contentDescription="Accepted by an NGO"
                        android:padding="6dp"
                        android:src="@drawable/ic_handshake" />
                    <View
                        android:id="@+id/line_step2"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginVertical="@dimen/space_4"
                        android:layout_weight="1"
                        android:minHeight="16dp"
                        android:background="@color/line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_step2_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Accepted by an NGO"
                            android:textAppearance="@style/TextAppearance.SNH.Label" />

                        <TextView
                            android:id="@+id/tv_step2_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.SNH.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_step2_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                </LinearLayout>
            </LinearLayout>
            <!-- Step 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_step3"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_todo"
                        android:contentDescription="Picked up"
                        android:padding="6dp"
                        android:src="@drawable/ic_local_shipping" />
                    <View
                        android:id="@+id/line_step3"
                        android:layout_width="2dp"
                        android:layout_height="0dp"
                        android:layout_marginVertical="@dimen/space_4"
                        android:layout_weight="1"
                        android:minHeight="16dp"
                        android:background="@color/line" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_step3_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Picked up"
                            android:textAppearance="@style/TextAppearance.SNH.Label" />

                        <TextView
                            android:id="@+id/tv_step3_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.SNH.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_step3_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                </LinearLayout>
            </LinearLayout>
            <!-- Step 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_step4"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_step_todo"
                        android:contentDescription="Delivered"
                        android:padding="6dp"
                        android:src="@drawable/ic_volunteer_activism" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_step4_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Delivered"
                            android:textAppearance="@style/TextAppearance.SNH.Label" />

                        <TextView
                            android:id="@+id/tv_step4_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.SNH.Caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_step4_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pickup -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pickup"
                    android:textAppearance="@style/TextAppearance.SNH.Section" />

                <TextView
                    android:id="@+id/tv_details_method"
                    style="@style/Widget.SNH.Tag" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Partner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:id="@+id/tv_details_avatar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_avatar"
                            android:gravity="center"
                            android:textAppearance="@style/TextAppearance.SNH.Label" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_details_ngo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />

                            <TextView
                                android:id="@+id/tv_details_ngo_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SNH.Caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/Widget.SNH.Divider" android:layout_marginHorizontal="@dimen/space_16" />

                    <!-- Contact -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_8">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_details_contact_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SNH.Caption" />

                            <TextView
                                android:id="@+id/tv_details_contact_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SNH.Label" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btn_driver_chat"
                            style="@style/Widget.SNH.IconButton"
                            android:background="@drawable/bg_icon_button_filled"
                            android:contentDescription="Send a message"
                            android:src="@drawable/ic_chat"
                            android:tint="@color/accent" />

                        <ImageButton
                            android:id="@+id/btn_driver_call"
                            style="@style/Widget.SNH.IconButton"
                            android:layout_marginStart="@dimen/space_8"
                            android:background="@drawable/bg_icon_button_filled"
                            android:contentDescription="Call"
                            android:src="@drawable/ic_call"
                            android:tint="@color/accent" />
                    </LinearLayout>

                    <View style="@style/Widget.SNH.Divider" android:layout_marginHorizontal="@dimen/space_16" />

                    <!-- Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_12"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_8">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_details_address_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SNH.Label" />

                            <TextView
                                android:id="@+id/tv_details_address"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_details_map"
                            style="@style/Widget.SNH.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Directions"
                            app:icon="@drawable/ic_near_me" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notes -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Notes from the kitchen" />

            <TextView
                android:id="@+id/tv_details_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.SNH.Body" />

            <!-- Impact -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_details_meals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.SNH.BodySmall"
                    app:drawableStartCompat="@drawable/ic_volunteer_activism"
                    app:drawableTint="@color/accent" />

                <TextView
                    android:id="@+id/tv_details_co2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.SNH.BodySmall"
                    app:drawableStartCompat="@drawable/ic_eco"
                    app:drawableTint="@color/accent" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Pinned actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/space_8"
            android:orientation="horizontal"
            android:showDividers="middle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_details"
                style="@style/Widget.SNH.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_handover_food"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_details_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.SNH.Caption" />
    </LinearLayout>
</LinearLayout>
