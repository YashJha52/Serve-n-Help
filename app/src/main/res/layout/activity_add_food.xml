<?xml version="1.0" encoding="utf-8"?>
<!-- Post surplus food: what, when, where, how it travels. Publish stays pinned in the thumb zone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_add_food"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4">

        <ImageButton
            android:id="@+id/btn_back_add_food"
            style="@style/Widget.SNH.IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:text="New donation"
            android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="What's left over?"
                android:textAppearance="@style/TextAppearance.SNH.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="NGOs near you see this as soon as you publish."
                android:textAppearance="@style/TextAppearance.SNH.BodySmall" />

            <!-- What -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:layout_marginTop="@dimen/space_24"
                android:text="The food" />

            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:text="Dish or item" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:hint="e.g. Veg biryani, chapatis, bread loaves"
                    android:id="@+id/et_food_name"
                    style="@style/Widget.SNH.EditText"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:text="Category" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.SNH.TextInput.Dropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <AutoCompleteTextView
                    android:id="@+id/actv_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:inputType="none"
                    android:paddingStart="@dimen/space_16"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SNH.FieldLabel"
                        android:text="How much" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:hint="20"
                            android:id="@+id/et_quantity"
                            style="@style/Widget.SNH.EditText"
                            android:inputType="number"
                            android:maxLength="5" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SNH.FieldLabel"
                        android:text="Unit" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.SNH.TextInput.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <AutoCompleteTextView
                            android:id="@+id/actv_unit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/button_height"
                            android:inputType="none"
                            android:paddingStart="@dimen/space_16"
                            android:textColor="@color/ink"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- When -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Timing" />

            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:text="When was it made?" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_schedule">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_prep_time"
                    style="@style/Widget.SNH.EditText"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SNH.FieldLabel"
                        android:text="Good until (date)" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@drawable/ic_calendar_today">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_expiry_date"
                            style="@style/Widget.SNH.EditText"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SNH.FieldLabel"
                        android:text="Time" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@drawable/ic_alarm">

                        <com.google.android.material.textfield.TextInputEditText
                            android:hint="Pick a time"
                            android:id="@+id/et_expiry_time"
                            style="@style/Widget.SNH.EditText"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_expiry_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:drawablePadding="@dimen/space_8"
                android:text="Cooked meals must be eaten within 6 hours for food safety."
                android:textAppearance="@style/TextAppearance.SNH.BodySmall"
                android:textColor="@color/warning"
                app:drawableStartCompat="@drawable/ic_warning"
                app:drawableTint="@color/warning" />

            <!-- Where -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Pickup point" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_12"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_8">

                    <ImageView
                        android:layout_width="@dimen/icon"
                        android:layout_height="@dimen/icon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pin_drop"
                        app:tint="@color/accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_pickup_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.SNH.Label" />

                        <TextView
                            android:id="@+id/tv_pickup_address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tv_change_address"
                        style="@style/Widget.SNH.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set on map" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notes -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Notes for the NGO" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <TextView android:id="@+id/chip_veg" style="@style/Widget.SNH.Chip" android:text="Vegetarian" />
                <TextView android:id="@+id/chip_nut_free" style="@style/Widget.SNH.Chip" android:text="Nut-free" />
                <TextView android:id="@+id/chip_halal" style="@style/Widget.SNH.Chip" android:text="Halal" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <com.google.android.material.textfield.TextInputEditText
                    android:hint="Allergens, packaging, which gate to come to…"
                    android:id="@+id/et_dietary_notes"
                    style="@style/Widget.SNH.EditText"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Delivery -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Who moves the food?" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_pickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_12"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_16">

                    <RadioButton
                        android:id="@+id/rb_pickup"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:checked="true"
                        android:contentDescription="NGO collects" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NGO collects it"
                            android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="A volunteer picks it up from your kitchen. Usually the quickest."
                            android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_self"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_12"
                    android:paddingStart="@dimen/space_4"
                    android:paddingEnd="@dimen/space_16">

                    <RadioButton
                        android:id="@+id/rb_self_delivery"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:contentDescription="I'll deliver" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="We'll drop it off"
                            android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Your staff take the food to the NGO that accepts it."
                            android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Pinned action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_12">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_publish_donation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/publish_donation" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="By publishing you confirm the food was handled and packed safely."
            android:textAppearance="@style/TextAppearance.SNH.Caption" />
    </LinearLayout>
</LinearLayout>
