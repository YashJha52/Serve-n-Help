<?xml version="1.0" encoding="utf-8"?>
<!-- One donation in the feed: status and urgency first, then what, how much, where. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_feed_status"
                style="@style/Widget.SNH.Tag" />

            <TextView
                android:id="@+id/tv_feed_expiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:drawablePadding="@dimen/space_4"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.SNH.Label"
                android:textColor="@color/warning"
                app:drawableStartCompat="@drawable/ic_schedule"
                app:drawableTint="@color/warning" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_feed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textAppearance="@style/TextAppearance.SNH.Section" />

        <TextView
            android:id="@+id/tv_feed_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.SNH.Label" />

        <TextView
            android:id="@+id/tv_feed_category_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.SNH.BodySmall" />

        <View
            style="@style/Widget.SNH.Divider"
            android:layout_marginTop="@dimen/space_12" />

        <TextView
            android:id="@+id/tv_feed_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:drawablePadding="@dimen/space_8"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.SNH.BodySmall"
            app:drawableStartCompat="@drawable/ic_location_on"
            app:drawableTint="@color/ink_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_feed_prep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.SNH.BodySmall"
                app:drawableStartCompat="@drawable/ic_schedule"
                app:drawableTint="@color/ink_muted" />

            <TextView
                android:id="@+id/tv_feed_fulfillment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.SNH.BodySmall"
                app:drawableStartCompat="@drawable/ic_local_shipping"
                app:drawableTint="@color/ink_muted" />
        </LinearLayout>

        <!-- Kept for the full expiry date; hidden in the compact card -->
        <TextView
            android:id="@+id/tv_feed_expires_time"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_feed_delete"
                style="@style/Widget.SNH.IconButton"
                android:contentDescription="Delete this donation"
                android:src="@drawable/ic_delete"
                android:tint="@color/danger" />

            <TextView
                android:id="@+id/tv_feed_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.SNH.Caption" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_feed_edit"
                style="@style/Widget.SNH.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_feed_info"
                style="@style/Widget.SNH.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View details"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="end" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
