<?xml version="1.0" encoding="utf-8"?>
<!-- One past donation / delivery. Opens the full details. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_12"
    android:paddingStart="@dimen/space_16"
    android:paddingEnd="@dimen/space_8">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_hist_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SNH.Label" />

        <TextView
            android:id="@+id/tv_hist_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SNH.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_hist_status"
        style="@style/Widget.SNH.Tag"
        android:layout_marginStart="@dimen/space_8" />

    <ImageView
        android:layout_width="@dimen/icon"
        android:layout_height="@dimen/icon"
        android:layout_marginStart="@dimen/space_4"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/ink_faint" />
</LinearLayout>
