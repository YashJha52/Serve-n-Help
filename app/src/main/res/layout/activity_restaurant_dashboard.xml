<?xml version="1.0" encoding="utf-8"?>
<!-- Donor home: who you are, your impact, what's live now. "Add food" is the one primary action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dashboard_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SNH.BodySmall" />

            <TextView
                android:id="@+id/tv_dashboard_restaurant_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SNH.Title" />

            <TextView
                android:id="@+id/tv_dashboard_kitchen_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:drawablePadding="@dimen/space_4"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.SNH.Caption"
                app:drawableStartCompat="@drawable/ic_verified_user"
                app:drawableTint="@color/accent" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_dashboard_notifications"
            style="@style/Widget.SNH.IconButton"
            android:contentDescription="Updates on your donations"
            android:src="@drawable/ic_notifications" />

        <ImageView
            android:id="@+id/iv_dashboard_profile"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_icon_button_filled"
            android:clickable="true"
            android:contentDescription="Your account"
            android:focusable="true"
            android:scaleType="center"
            android:src="@drawable/ic_person"
            app:tint="@color/ink" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_margin">

                <!-- Impact band -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/bg_band"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_16">

                        <TextView
                            android:id="@+id/tv_stat_total_kg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.SNH.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="kg rescued"
                            android:textAppearance="@style/TextAppearance.SNH.Caption" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_16">

                        <TextView
                            android:id="@+id/tv_stat_active"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.SNH.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="live now"
                            android:textAppearance="@style/TextAppearance.SNH.Caption" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_16">

                        <TextView
                            android:id="@+id/tv_stat_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.SNH.Title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="delivered"
                            android:textAppearance="@style/TextAppearance.SNH.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Shown only when something expires within 2 hours -->
                <TextView
                    android:id="@+id/tv_stat_urgent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/warning_tint"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_12"
                    android:text="Some of your food expires within 2 hours. NGOs nearby can see it now."
                    android:textAppearance="@style/TextAppearance.SNH.BodySmall"
                    android:textColor="@color/warning"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_alarm"
                    app:drawableTint="@color/warning" />

                <!-- Active donations -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_32"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live donations"
                        android:textAppearance="@style/TextAppearance.SNH.Section" />

                    <TextView
                        android:id="@+id/tv_available_count"
                        style="@style/Widget.SNH.Tag"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="0" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tv_see_all_donations"
                        style="@style/Widget.SNH.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/see_all" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_donation_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btn_add_food_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_16"
            android:text="@string/add_food_cta"
            app:icon="@drawable/ic_add" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
