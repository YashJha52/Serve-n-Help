<?xml version="1.0" encoding="utf-8"?>
<!-- Create account: role first, then grouped fields, then one primary action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_create_account"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_4">

        <ImageButton
            android:id="@+id/btn_back_create_account"
            style="@style/Widget.SNH.IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:text="Create account"
            android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="Join Serve-N-Help"
                android:textAppearance="@style/TextAppearance.SNH.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="Kitchens post surplus food. NGOs collect it and get it to people who need a meal."
                android:textAppearance="@style/TextAppearance.SNH.BodySmall" />

            <!-- Role -->
            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:layout_marginTop="@dimen/space_24"
                android:text="Who are you signing up as?" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_donor_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon"
                        android:layout_height="@dimen/icon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_restaurant"
                        app:tint="@color/ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Food donor"
                            android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Restaurants, caterers, bakeries, hostels and events with food left over."
                            android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_donor_checked"
                        android:layout_width="@dimen/icon"
                        android:layout_height="@dimen/icon"
                        android:background="@drawable/bg_check_on"
                        android:contentDescription="Selected"
                        android:padding="4dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/on_accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ngo_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon"
                        android:layout_height="@dimen/icon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_volunteer_activism"
                        app:tint="@color/ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NGO or shelter"
                            android:textAppearance="@style/TextAppearance.SNH.ItemTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Food banks, shelters and community kitchens that collect and serve meals."
                            android:textAppearance="@style/TextAppearance.SNH.BodySmall" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_ngo_checked"
                        android:layout_width="@dimen/icon"
                        android:layout_height="@dimen/icon"
                        android:background="@drawable/bg_check_off"
                        android:contentDescription="Not selected"
                        android:padding="4dp"
                        android:src="@drawable/ic_check"
                        app:tint="@android:color/transparent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Organisation -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Organisation" />

            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:text="Organisation name" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:hint="@string/org_name_hint"
                    android:id="@+id/et_org_name"
                    style="@style/Widget.SNH.EditText"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:text="Contact person" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:hint="Full name"
                    android:id="@+id/et_rep_name"
                    style="@style/Widget.SNH.EditText"
                    android:autofillHints="name"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contact -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Contact" />

            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:text="Email" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:hint="you@organisation.in"
                    android:id="@+id/et_register_email"
                    style="@style/Widget.SNH.EditText"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:text="Mobile number" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="NGOs call this number to arrange pickups."
                app:prefixText="+91 "
                app:prefixTextColor="@color/ink_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_mobile_phone"
                    style="@style/Widget.SNH.EditText"
                    android:autofillHints="phoneNational"
                    android:inputType="phone"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SNH.FieldLabel"
                        android:text="City" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:hint="Mumbai"
                            android:id="@+id/et_city"
                            style="@style/Widget.SNH.EditText"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SNH.FieldLabel"
                        android:text="Pincode" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:hint="400056"
                            android:id="@+id/et_pincode"
                            style="@style/Widget.SNH.EditText"
                            android:autofillHints="postalCode"
                            android:inputType="number"
                            android:maxLength="6" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Verification -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Verification" />

            <TextView
                android:id="@+id/tv_license_label"
                style="@style/Widget.SNH.FieldLabel"
                android:text="@string/fssai_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:helperText="@string/fssai_helper"
                app:startIconDrawable="@drawable/ic_verified_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:hint="@string/fssai_hint"
                    android:id="@+id/et_license_id"
                    style="@style/Widget.SNH.EditText"
                    android:inputType="textCapCharacters" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <TextView
                style="@style/Widget.SNH.SectionTitle"
                android:text="Password" />

            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:text="Create a password" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:hint="At least 8 characters"
                    android:id="@+id/et_create_password"
                    style="@style/Widget.SNH.EditText"
                    android:autofillHints="newPassword"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/layout_password_strength"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="@dimen/space_8"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/line" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/space_4"
                    android:layout_weight="1"
                    android:background="@color/line" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/line" />
            </LinearLayout>

            <TextView
                style="@style/Widget.SNH.FieldLabel"
                android:text="Confirm password" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_confirm_password"
                    style="@style/Widget.SNH.EditText"
                    android:autofillHints="newPassword"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_agree_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:minHeight="@dimen/touch_target"
                android:text="I'm authorised to register this organisation and agree to follow safe food-handling practices."
                android:textAppearance="@style/TextAppearance.SNH.BodySmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_account_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/create_restaurant_account" />

            <TextView
                android:id="@+id/tv_navigate_signin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_8"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Already have an account? Sign in"
                android:textAppearance="@style/TextAppearance.SNH.Label"
                android:textColor="@color/accent" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
